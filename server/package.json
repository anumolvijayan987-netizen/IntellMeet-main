{
  "name": "intellmeet-server",
  "version": "1.0.0",
  "description": "Backend API & Real-time Socket Server for IntellMeet",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
