# =====================================================================
# INTELLMEET CLIENT ENVIRONMENT VARIABLES (Vercel / Vite)
# =====================================================================
# Set these in your Vercel Project Settings > Environment Variables.
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the client.
# NEVER include database connection strings, JWT secrets, or API keys here.

# The public URL of your persistent backend API (e.g. Render, Railway, Fly.io, AWS)
VITE_API_URL=https://intellmeet-api.onrender.com

# The public URL of your Socket.io real-time signaling server
VITE_SOCKET_URL=https://intellmeet-api.onrender.com
