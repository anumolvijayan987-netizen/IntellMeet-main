# =====================================================================
# INTELLMEET PRODUCTION ENVIRONMENT TEMPLATE
# =====================================================================
# Copy this file to .env and configure for your deployment environment.
# NEVER commit real production credentials or API keys to version control.

# ---------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ---------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PREFIX=/api
LOG_LEVEL=info

# ---------------------------------------------------------------------
# 2. PERSISTENT DATABASE (MongoDB Atlas or Self-Hosted)
# ---------------------------------------------------------------------
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/intellimeet?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://intellmeet_admin:ENTER_SECURE_PASSWORD@cluster0.mongodb.net/intellimeet?retryWrites=true&w=majority

# ---------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ---------------------------------------------------------------------
# Generate high-entropy 256-bit secrets using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_distinct_secure_random_base64_secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_signing_secret_key_here

# ---------------------------------------------------------------------
# 4. CORS & CLIENT DOMAINS
# ---------------------------------------------------------------------
# Comma-separated list of allowed frontend domains
CLIENT_URL=https://intellmeet.vercel.app,http://localhost:5173

# ---------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE (OpenAI Whisper & GPT-4o)
# ---------------------------------------------------------------------
# Provider: 'openai' (uses live OpenAI API) or 'builtin' (contextual zero-latency engine)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_OPENAI_API_KEY_HERE

# ---------------------------------------------------------------------
# 6. CLOUD OBJECT STORAGE (Cloudflare R2, AWS S3, or MinIO)
# ---------------------------------------------------------------------
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_BUCKET=intellmeet-recordings
STORAGE_ACCESS_KEY=your_r2_or_s3_access_key_id
STORAGE_SECRET_KEY=your_r2_or_s3_secret_access_key
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://storage.yourdomain.com/recordings

# ---------------------------------------------------------------------
# 7. REAL-TIME VIDEO & SFU INFRASTRUCTURE (LiveKit / STUN / TURN)
# ---------------------------------------------------------------------
VIDEO_PROVIDER_URL=wss://livekit.yourdomain.com
VIDEO_PROVIDER_API_KEY=your_livekit_api_key
VIDEO_PROVIDER_API_SECRET=your_livekit_api_secret

# STUN/TURN servers for symmetric NAT traversal:
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=turn:turn.yourdomain.com:3478
TURN_USERNAME=intellmeet_turn_user
TURN_CREDENTIAL=turn_secure_password_or_token

# ---------------------------------------------------------------------
# 8. FRONTEND CLIENT (Vercel / Vite Configuration)
# ---------------------------------------------------------------------
# Public backend endpoints (never put server secrets here)
VITE_API_URL=https://api.yourdomain.com
VITE_SOCKET_URL=https://api.yourdomain.com
